pipeline {
    agent any

    stages {
        stage('Setup') {
            steps {
                echo ' Installing dependencies...'
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -r requirements.txt
                    pip install mlflow pytest
                '''
            }
        }

        stage('Run Tests') {
            steps {
                echo ' Running tests...'
                sh '''
                    . venv/bin/activate
                    pytest tests/ -v || echo "No tests found"
                '''
            }
        }

        stage('Train Model') {
            steps {
                echo ' Training model with MLflow...'
                sh '''
                    . venv/bin/activate
                    export MLFLOW_TRACKING_URI=http://172.24.198.42:5000
                    python src/train.py
                '''
            }
        }
    }

    post {
        always {
            echo ' Cleaning up...'
            sh 'rm -rf venv'
        }
        success {
            echo ' Pipeline completed successfully!'
        }
        failure {
            echo ' Pipeline failed!'
        }
    }
}
